# Copy to .env.local for `vercel dev`. Set the real values in Vercel → Project → Settings → Environment Variables.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# Shared secret required by /api/generate-questions and /api/generate-script (openssl rand -hex 32)
CONTENT_ENGINE_API_TOKEN=
# Added automatically when a Vercel Blob store is connected
BLOB_READ_WRITE_TOKEN=
