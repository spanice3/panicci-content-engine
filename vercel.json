{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/:client",
      "destination": "/testimonial"
    }
  ],
  "functions": {
    "api/fifty-five-three.js": {
      "maxDuration": 60
    },
    "api/upload-testimonial.js": {
      "includeFiles": "clients/*.json"
    },
    "api/post-instagram.js": {
      "maxDuration": 60
    }
  }
}
